s20 = input.symbol("NSE:CIPLA", "Stock 20  -  Cipla", group=grp_list)
s21 = input.symbol("NSE:DIVISLAB", "Stock 21  -  Divi's Laboratories", group=grp_list)
s22 = input.symbol("NSE:DRREDDY", "Stock 22  -  Dr. Reddy's Laboratories", group=grp_list)
s23 = input.symbol("NSE:LUPIN", "Stock 23  -  Lupin", group=grp_list)
