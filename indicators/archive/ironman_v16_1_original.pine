//@version=5
indicator("IronMan v16.1 - Sorted F&O Screener", overlay=true)

// ========================================================================= //
// 1. INPUTS & WATCHLIST CONFIGURATION
// ========================================================================= //
grp_ui       = "Screener Table Settings"
table_pos    = input.string(position.top_right, "Table Position", options=[position.top_right, position.bottom_right, position.top_left, position.bottom_left], group=grp_ui)
table_size   = input.string("Normal", "Text Size", options=["Small", "Normal", "Large"], group=grp_ui)

grp_list = "F&O Watchlist Symbols (Top 30)"
s01 = input.symbol("NSE:RELIANCE", "Stock 01", group=grp_list)
