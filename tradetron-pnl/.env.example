# Copy to .env for local runs. .env is git-ignored. In GitHub Actions these come
# from repository Secrets / Variables instead (see .github/workflows/pnl.yml).

# Tradetron -> Developer API -> create a READ-ONLY key
TRADETRON_API_KEY=
# Only change if your account's Developer API page shows a different base URL
# TRADETRON_API_BASE_URL=https://tradetron.tech/api/v1

# @BotFather token and the chat to post to (see docs/TELEGRAM.md for the chat id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# What the API's "pnl" means for your account: cumulative (since deployment) or today
TTPNL_PNL_SEMANTICS=cumulative
# Tax head for deployments not listed in config/deployments.csv
TTPNL_DEFAULT_SEGMENT=fno
# Reporting currency; other currencies are shown separately, never summed in
TTPNL_CURRENCY=INR
# Per-deployment positions calls (1/0) and how many deployments at most per run
TTPNL_FETCH_POSITIONS=1
TTPNL_MAX_POSITIONS=25
# Send a short message at the 09:00 pre-open run (default: silent)
TTPNL_PREOPEN_MESSAGE=0
# Hourly updates without a notification sound (1/0)
TTPNL_SILENT_HOURLY=0
